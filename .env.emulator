# Copy this file to .env.local before running `npm run dev` against
# the local Firebase emulator suite. The frontend will pick up these values
# via Vite's import.meta.env.* at build/dev time.

VITE_FIREBASE_API_KEY=demo-key
VITE_FIREBASE_AUTH_DOMAIN=demo.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=demo-caldero-envio
VITE_FIREBASE_STORAGE_BUCKET=demo.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:0000000000000000

VITE_MAPBOX_GL_TOKEN=pk.your-mapbox-token-here

# CRITICAL: when true, src/config/firebase.js connects Auth/Firestore/Functions
# to localhost. Also flips calderoService / purchaseService / AuthContext to
# use httpsCallable (SDK resolution via region) instead of httpsCallableFromURL.
VITE_USE_FIREBASE_EMULATORS=true
