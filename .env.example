# Firebase
VITE_FIREBASE_API_KEY=demo-key
VITE_FIREBASE_AUTH_DOMAIN=demo.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=demo-project
VITE_FIREBASE_STORAGE_BUCKET=demo.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:0000000000000000

# Mapbox
VITE_MAPBOX_GL_TOKEN=pk.your-mapbox-token-here

# Emulator mode
# Set to "true" to point the frontend at the local Firebase emulator suite
# (auth :9099, firestore :8080, functions :5001, hosting :5000).
# When "true", VITE_FIREBASE_* values above are ignored and the emulator
# uses demo credentials.
# When "false" or unset, the frontend talks to production.
VITE_USE_FIREBASE_EMULATORS=false
