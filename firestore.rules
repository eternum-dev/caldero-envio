rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ──────────────────────────────────

    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // ── Users ────────────────────────────────────
    // NOTE: The previous rules used hasAll(['uid', 'email', 'createdAt'])
    // and request.resource.data.uid == resource.data.uid checks. These
    // caused "evaluation error at L15:24" PERMISSION_DENIED failures
    // during the onboarding wizard's updateUser() call (merge write that
    // did not always carry email/createdAt). Simplified to plain owner
    // checks — schema-level invariants are enforced in application code
    // and Cloud Functions, not in rules.
    // TODO: Re-add field-level validation once the update flow is
    // refactored to always include uid + email + createdAt on writes.

    match /users/{userId} {
      allow read: if isOwner(userId);
      allow write: if isOwner(userId);
      allow delete: if false;
    }

    // ── Stores ───────────────────────────────────

    match /stores/{userId} {
      allow read: if isOwner(userId);
      allow create, update: if isOwner(userId);
      allow delete: if false;
    }

    // ── Couriers ─────────────────────────────────

    match /couriers/{userId} {
      allow read: if isOwner(userId);
      allow create, update: if isOwner(userId);
      allow delete: if false;
    }

    // ── Accounts (monetization — server-write only) ──

    match /accounts/{userId} {
      allow read: if isOwner(userId);
      allow write: if false;
    }

    // ── Transactions (monetization — server-write only) ──

    match /transactions/{txId} {
      allow read: if isOwner(resource.data.uid);
      allow write: if false;
    }

    // ── Pending purchases (monetization — server-write only) ──

    match /pending_purchases/{purchaseId} {
      allow read: if isOwner(resource.data.uid);
      allow write: if false;
    }

    // ── Catch-all: deny everything else ──────────

    match /{document=**} {
      allow read, write: if false;
    }
  }
}